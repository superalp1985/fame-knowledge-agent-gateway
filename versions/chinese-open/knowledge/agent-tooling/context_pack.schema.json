{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fame.local/schemas/chinese-open-context-pack.schema.json",
  "title": "FAME Context Pack",
  "type": "object",
  "required": [
    "edition_id",
    "project_id",
    "task_id",
    "subject",
    "semantic_anchor",
    "route_ids",
    "abstraction_level",
    "thought_mode",
    "summaries",
    "content_refs",
    "rules",
    "negative_lessons",
    "context_budget"
  ],
  "properties": {
    "edition_id": { "const": "chinese-open" },
    "project_id": { "type": "string" },
    "task_id": { "type": "string" },
    "subject": { "type": "string" },
    "semantic_anchor": { "const": "language-tree-hub" },
    "lexicon_refs": { "type": "array", "items": { "type": "string" } },
    "route_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "abstraction_level": {
      "enum": ["L0_meta", "L1_discipline", "L2_field", "L3_topic", "L4_method", "L5_operation", "L6_case"]
    },
    "thought_mode": {
      "enum": ["L0_meta", "L1_discipline", "L2_field", "L3_topic", "L4_method", "L5_operation", "L6_case"]
    },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "summary"],
        "properties": {
          "ref": { "type": "string" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "content_refs": { "type": "array", "items": { "type": "string" } },
    "rules": { "type": "array", "items": { "type": "string" } },
    "negative_lessons": { "type": "array", "items": { "type": "string" } },
    "context_budget": { "type": "integer", "minimum": 512, "maximum": 12000 },
    "resume_point": {
      "type": "object",
      "properties": {
        "current_goal": { "type": "string" },
        "loaded_refs": { "type": "array", "items": { "type": "string" } },
        "next_step": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
