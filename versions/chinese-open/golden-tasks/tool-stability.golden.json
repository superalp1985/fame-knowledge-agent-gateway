{
  "edition_id": "chinese-open",
  "purpose": "固定 5 个工具稳定性任务，用来证明 Agent 接入后能立刻少犯错。",
  "tasks": [
    {
      "id": "golden-powershell-delete",
      "goal": "PowerShell 删除目录但要避免误删",
      "args": ["--operation", "delete", "--tool-name", "exec_command", "--working-directory", "<project-root>", "--expected-output", "列出绝对路径并等待审批"],
      "expected_scenario": "scenario-powershell-destructive-delete",
      "must_have": ["requires_approved_action", "route-powershell-safe-command"]
    },
    {
      "id": "golden-jsonl-edit",
      "goal": "修改 JSONL 知识库并同步索引",
      "args": [],
      "expected_scenario": "scenario-jsonl-knowledge-edit",
      "must_have": ["route-agent-database-sync", "route-logic-knowledge-consistency"]
    },
    {
      "id": "golden-git-dirty-worktree",
      "goal": "准备修改文件但要保护 Git 脏工作区",
      "args": ["--operation", "write"],
      "expected_scenario": "scenario-git-dirty-worktree",
      "must_have": ["tool-failure-dirty-worktree-overwrite"]
    },
    {
      "id": "golden-node-build",
      "goal": "运行 npm test 前确认工作目录和 package.json",
      "args": ["--operation", "build"],
      "expected_scenario": "scenario-node-npm-build",
      "must_have": ["tool-failure-wrong-working-directory"]
    },
    {
      "id": "golden-no-evidence-no-complete",
      "goal": "工程改完后不能在未测试时宣称完成",
      "args": ["--operation", "build"],
      "expected_scenario": "scenario-node-npm-build",
      "must_have": ["tool-failure-test-claim-without-evidence", "result-pattern-command-success"]
    }
  ]
}
