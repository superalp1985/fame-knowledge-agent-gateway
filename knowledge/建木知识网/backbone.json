        "name": "词汇映射规律",
        "rule": "中文词 → 英语对应词 → 建木知识域映射",
        "examples": [
          "加速 → accelerate/speedup → 迷龙算法域",
          "收敛 → converge → SCAC量化域",
          "凭证 → voucher → 会计系统域"
        ]
      },
      {
        "id": "lang_rule_syntax_pattern",
        "name": "句型结构规律",
        "rule": "SVO语序 + Topic-Comment结构 + 时间状语前置",
        "examples": [
          "SVO: 我(主)+运行(动)+测试(宾) → 动作定位",
          "Topic-Comment: 这个算法，(它)适合MCU → 话题-说明结构"
        ]
      },
      {
        "id": "lang_rule_semantic_mapping",
        "name": "语义映射规律",
        "rule": "中文表达 → 语义意图 → 知识检索",
        "examples": [
          "能不能...? → 能力询问 → 可行性分析节点",
          "帮我... → 执行请求 → 工具调用节点",
          "你觉得...? → 意见征求 → 推理引擎启动"
        ]
      }
